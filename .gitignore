# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual env
venv/
.venv/
env/

# IDE
.vscode/settings.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project outputs (regenerable)
outputs/*
!outputs/.gitkeep

# Models (large files, regenerated locally)
models/*.pkl
models/*.pth
models/*.pt
models/training_metadata.json
!models/.gitkeep

# Sample data placeholders
!data/genuine/.gitkeep
!data/tampered/.gitkeep

# TruFor third-party code (cloned fresh, not vendored)
third_party/TruFor/

# Node / frontend
node_modules/
frontend/**/node_modules/
npm-debug.log*
.manus-logs/
*.tsbuildinfo

# Transient uploads
uploads/*
!uploads/.gitkeep

# Environment / secrets — never commit
.env
.env.*
*.local
